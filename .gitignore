# Godot 4+ specific ignores
.godot/
/android/
/package/*
!/package/.gdignore

# Godot UID sidecars are project metadata when they sit next to source files.
!src/**/*.gd.uid
!src/**/*.gdshader.uid

# Godot import metadata is not useful inside directories hidden with .gdignore.
/archive/legacy_images/**/*.import
/assets/sourceImage/**/*.import

# Python helper script output
__pycache__/
*.py[cod]

# Local Obsidian workspace state
spec/.obsidian/workspace.json

# AI workflow local state
.ai-state/
.queue/
.codex_tmp/
.tmp/
transition_reference.gif
transition_result.gif

# Local release/build scratch space
/tmp/*
!/tmp/.gdignore
